{
  "name": "ais-nmea-decoder",
  "version": "1.0.0",
  "description": "Decode AIS and NMEA messages",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --out docs/api src/index.ts",
    "test": "vitest",
    "cov": "vitest run --coverage && open coverage/index.html",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayofthefuture/ais-nmea-decoder.git"
  },
  "keywords": [
    "ais",
    "nmea",
    "gnss",
    "decode",
    "decoder"
  ],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wayofthefuture/ais-nmea-decoder/issues"
  },
  "homepage": "https://github.com/wayofthefuture/ais-nmea-decoder#readme",
  "dependencies": {
    "bitwise": "^2.2.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "rolldown": "^1.2.4",
    "rolldown-plugin-dts": "^0.28.2",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
